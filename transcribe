#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OFASR="$ROOT_DIR/bin/ofasr"
FFMPEG="$ROOT_DIR/bin/ffmpeg"
MODEL_DIR="$ROOT_DIR/model"

usage() {
  cat <<'USAGE'
Usage:
  ./transcribe <audio-file> [-o output.txt]
  ./transcribe <audio-file> --json [-o output.json]

Examples:
  ./transcribe ~/Downloads/demo.mp3
  ./transcribe ~/Downloads/demo.wav -o ~/Downloads/demo.txt
  ./transcribe ~/Downloads/demo.m4a --json -o result.json

Notes:
  - Works best on macOS Apple Silicon.
  - Input can be mp3, wav, m4a, mp4, mov, etc. ffmpeg converts it internally.
  - The bundled ASR model is local. No model download is required.
USAGE
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

INPUT=""
OUTPUT=""
JSON=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      OUTPUT="$2"
      shift 2
      ;;
    --json)
      JSON=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$INPUT" ]]; then
        INPUT="$1"
        shift
      else
        echo "Unexpected argument: $1" >&2
        usage
        exit 2
      fi
      ;;
  esac
done

if [[ -z "$INPUT" ]]; then
  echo "Missing audio file." >&2
  usage
  exit 2
fi

if [[ ! -f "$INPUT" ]]; then
  echo "Audio file not found: $INPUT" >&2
  exit 1
fi

if [[ ! -x "$OFASR" ]]; then
  echo "Missing executable: $OFASR" >&2
  exit 1
fi

if [[ ! -x "$FFMPEG" ]]; then
  echo "Missing executable: $FFMPEG" >&2
  exit 1
fi

if [[ ! -f "$MODEL_DIR/model.onnx" || ! -f "$MODEL_DIR/tokens.json" ]]; then
  echo "Bundled ASR model is incomplete: $MODEL_DIR" >&2
  exit 1
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/asr_cli.XXXXXX")"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

WAV="$TMP_DIR/input-16k-mono.wav"
"$FFMPEG" -hide_banner -loglevel error -y -nostdin \
  -i "$INPUT" \
  -vn -ac 1 -ar 16000 -c:a pcm_s16le "$WAV"

if [[ "$JSON" -eq 1 ]]; then
  RESULT="$("$OFASR" transcribe --file "$WAV" --model "$MODEL_DIR" --json)"
else
  RESULT="$("$OFASR" transcribe --file "$WAV" --model "$MODEL_DIR")"
fi

if [[ -n "$OUTPUT" ]]; then
  mkdir -p "$(dirname "$OUTPUT")"
  printf '%s\n' "$RESULT" > "$OUTPUT"
else
  printf '%s\n' "$RESULT"
fi
