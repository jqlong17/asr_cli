#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OFASR="$ROOT_DIR/bin/ofasr"
MODEL_DIR="$ROOT_DIR/model"
ADDR="${ASR_CLI_ADDR:-127.0.0.1:8765}"

usage() {
  cat <<'USAGE'
Usage:
  ./serve [--addr 127.0.0.1:8765]

Examples:
  ./serve
  ./serve --addr 127.0.0.1:8766

Notes:
  - Keeps the ASR model loaded until you stop it with Ctrl-C.
  - Exposes local HTTP endpoints:
      GET  /health
      POST /transcribe
      POST /transcribe.txt
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --addr)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --addr" >&2
        exit 2
      fi
      ADDR="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      usage
      exit 2
      ;;
  esac
done

exec "$OFASR" serve --model "$MODEL_DIR" --addr "$ADDR"
